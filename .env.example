ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://scanner:change-me@postgres:5432/api_scanner
REDIS_URL=redis://redis:6379/0
SCANNER_API_KEY=replace-with-a-long-random-api-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key
ENGINE_RUNNER_TOKEN=replace-with-a-long-random-runner-token
ZAP_URL=http://zap:8080
ZAP_API_KEY=replace-with-a-long-random-zap-key
ZAP_SHARED_DIRECTORY=/engine-data
NUCLEI_RUNNER_URL=http://nuclei:8091
WFUZZ_RUNNER_URL=http://wfuzz:8092
WUPPIEFUZZ_RUNNER_URL=http://wuppiefuzz:8093
# Public callback base supplied to authorized targets and private collector polling URL.
# In cloud deployments expose only /c/* publicly; keep /events/* private.
OAST_CALLBACK_BASE_URL=https://oast.example.com/c
OAST_POLL_BASE_URL=http://oast:8094
OAST_API_KEY=replace-with-a-long-random-oast-key
SCAN_TIMEOUT=1800
REQUEST_TIMEOUT=10
MAX_CONCURRENCY=10
MAX_REQUESTS=2000
DEFAULT_RATE_LIMIT=10
MAX_SPEC_SIZE=5242880
MAX_RESPONSE_SIZE=2097152
# Comma-separated exact hosts or wildcard subdomains such as *.example.com
ALLOWED_TARGETS=api.example.com
ALLOW_PRIVATE_TARGETS=false
# deployment_allowlist: every target must match ALLOWED_TARGETS.
# platform_managed: the trusted parent backend supplies project and authorization references.
TARGET_SCOPE_MODE=deployment_allowlist
# disabled: simple local UI only (rejected in production); gateway: parent platform protects it.
# api_key remains available for direct service-to-service API clients.
DASHBOARD_AUTH_MODE=disabled
LOG_LEVEL=INFO
TASK_ALWAYS_EAGER=false
REPORT_DIRECTORY=/data/reports
